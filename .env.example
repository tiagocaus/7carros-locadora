APP_NAME="7Carros - Locadora"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://locadora.7carros.com.local
APP_KEY=your_secure_random_key_here_min_32_chars
APP_COMPANY_EMAIL=
APP_ADMINISTRADORES="" # Lista de administradores separados por vírgula. Usar o usuario.
APP_COMPANY_TELEFONE_WHATSAPP=
# Desenvolvimento - Tenant permitido para notificações em desenvolvimento
# Em APP_ENV=development, só envia notificações para este tenant (vazio = permite todos)
DEV_ALLOWED_NOTIFICATION_TENANT=

# Website Module
TENANT_ONBOARD_SECRET=chave-secreta-compartilhada-com-whmcs

# WhatsApp Integration
WHATSAPP_API_URL=
WHATSAPP_API_ADMIN_TOKEN=
WHATSAPP_API_INSTANCE_TOKEN=
WHATSAPP_API_PROXY_PROTOCOL=
WHATSAPP_API_PROXY_HOST=
WHATSAPP_API_PROXY_PORT=
WHATSAPP_API_PROXY_USERNAME=
WHATSAPP_API_PROXY_PASSWORD=
#Instancia do sistema "7Carros", usado para enviar mensagens a partir do sistema.
WHATSAPP_API_INSTANCE_TOKEN=

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=7carros_locadora
DB_USERNAME=root
DB_PASSWORD=

# Redis Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2.5
REDIS_PREFIX=7carros_cache:
CACHE_TTL=3600

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notification@7carros.com
MAIL_FROM_NAME="Locadora de veículos"
MAIL_BOUNCE_ADDRESS=bounce@7carros.com

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

INTER_AMBIENTE=sandbox
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=
INTER_KEY_PATH=
INTER_PIX_KEY=
INTER_CONTA_CORRENTE=

# API & CORS Configuration
CORS_ALLOWED_ORIGINS=*
# Google Maps (client-side: Maps JavaScript API, Places, Geocoding, etc.)
GOOGLE_MAPS_API_KEY=

# CRON Configuration
# CRON jobs are executed via CLI: php cron.php
# Set to true to enable verbose logging
CRON_VERBOSE_LOGGING=true
# Log file retention (days)
CRON_LOG_RETENTION_DAYS=30

# Upload Configuration
UPLOAD_DISK=local
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,svg,webp,pdf

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq.hostcia.net
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_NAME=messages_queue
RABBITMQ_DEBUG=false

# Message Queue Processing Configuration
QUEUE_MAX_MESSAGES_PER_RUN=50
QUEUE_MAX_ATTEMPTS=3
QUEUE_CONSUME_TIMEOUT=30

# TinyMCE Configuration
# Use 'gpl' for open source or your commercial license key
TINYMCE_LICENSE_KEY=gpl

# Manutenção Preventiva
MANUTENCAO_MARGEM_KM=500
MANUTENCAO_CRON_ENABLED=true
MANUTENCAO_NOTIFICAR_EMAIL=false
MANUTENCAO_NOTIFICAR_WHATSAPP=false

# API de consultas online
SERPRO_BEARER_TOKEN=
SERPRO_BASE_URL=https://efrotas.estaleiro.serpro.gov.br/efrotas/api
SERPRO_BASE_URL_TRANSACIONAL=https://efrotas.estaleiro.serpro.gov.br/efrotas/api/transacional
SERPRO_BASE_URL_CRLV=https://efrotas.estaleiro.serpro.gov.br/efrotas/api
SERPRO_AMBIENTE=homologacao
SERPRO_WEBHOOK_SECRET=

# SERPRO - Precos e Markup
SERPRO_PRECO_CONSULTA=0.43
SERPRO_PRECO_EVENTO=1.07
SERPRO_MARKUP_PERCENT=10

# SERPRO - Recarga
SERPRO_RECARGA_MINIMA=100.00
SERPRO_AUTO_RECARGA_VALOR=100.00
SERPRO_AUTO_RECARGA_LIMITE=100.00
