# Arquivos de ambiente
.env*

# Apenas o exemplo deve ser versionado
!.env.example

# Arquivos do sistema
.DS_Store
Thumbs.db
temp.txt
temp-bd.txt
temp-ftp.txt
temp-lftp.txt
QA.md

# Logs
storage/logs/*
!storage/logs/.gitkeep

# Cache
storage/cache/*
!storage/cache/.gitkeep

# Estados gerados
storage/cron/*.json
temp/

# Uploads (se necessário)
storage/uploads/*
!storage/uploads/.gitkeep

# Certificados (mTLS, SSL) - NUNCA commitar
storage/certificates/*
!storage/certificates/.gitkeep

# IDE
.codex/
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# Composer
vendor/
composer.lock

# Assets vendor públicos necessários no deploy
!public/assets/vendor/
!public/assets/vendor/**
public/assets/vendor/**/.DS_Store

# PHP
*.log
php_errors.log
