    {
      "name": "Boleto SNE",
      "item": [
        {
          "name": "Solicitar Boleto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/hal+json"
              }
            ],
            "url": {
              "raw": "{{base_url_transacional}}/v1/boleto/solicitarBoleto?cnpjFilial={{cnpj_teste}}&placa={{placa_teste}}&chaveInfracao=267890SRPO-876127455&desconto40=false",
              "host": [
                "{{base_url_transacional}}"
              ],
              "path": [
                "v1",
                "boleto",
                "solicitarBoleto"
              ],
              "query": [
                {
                  "key": "cnpjFilial",
                  "value": "{{cnpj_teste}}",
                  "description": "CNPJ da filial (opcional - se não informado será usado o do token)"
                },
                {
                  "key": "placa",
                  "value": "{{placa_teste}}",
                  "description": "Placa do veículo (obrigatório)"
                },
                {
                  "key": "chaveInfracao",
                  "value": "267890SRPO-876127455",
                  "description": "Chave única da infração (obrigatório)"
                },
                {
                  "key": "desconto40",
                  "value": "false",
                  "description": "Aplicar desconto de 40% (obrigatório)"
                }
              ]
            },
            "description": "Solicita a emissão de boleto para pagamento de infração. ESTE GRUPO ESTÁ EM HOMOLOGAÇÃO INTERNA."
          },
          "response": []
        },
        {
          "name": "Reconhecer Infração",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/hal+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"termos\": \"Declaro que reconheço a infração e concordo com os termos de pagamento\"\n}"
            },
            "url": {
              "raw": "{{base_url_transacional}}/v1/boleto/reconhecerInfracao?cnpjFilial={{cnpj_teste}}&placa={{placa_teste}}&chaveInfracao=267890SRPO-876127455",
              "host": [
                "{{base_url_transacional}}"
              ],
              "path": [
                "v1",
                "boleto",
                "reconhecerInfracao"
              ],
              "query": [
                {
                  "key": "cnpjFilial",
                  "value": "{{cnpj_teste}}",
                  "description": "CNPJ da filial (obrigatório)"
                },
                {
                  "key": "placa",
                  "value": "{{placa_teste}}",
                  "description": "Placa do veículo (obrigatório)"
                },
                {
                  "key": "chaveInfracao",
                  "value": "267890SRPO-876127455",
                  "description": "Chave única da infração (obrigatório)"
                }
              ]
            },
            "description": "Reconhece uma infração de trânsito com base nos dados fornecidos. Requer declaração de concordância com os termos no body."
          },
          "response": []
        },
        {
          "name": "Consultar PDF do Boleto",
