{
    "name": "7carros/locadora",
    "description": "Sistema de gestão para locadora de veículos",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Tiago",
            "email": "contato@7carros.com.br",
            "homepage": "https://www.7carros.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": []
    },
    "require": {
        "mpdf/mpdf": "8.2.5",
        "zircote/swagger-php": "^4.0",
        "phpmailer/phpmailer": "6.6.*",
        "simplesoftwareio/simple-qrcode": "4.2.*",
        "codephix/asaas-sdk": "2.0.*",
        "ext-mysqli": "*",
        "ext-json": "*",
        "efipay/sdk-php-apis-efi": "^1.17",
        "php-amqplib/php-amqplib": "3.7.4",
        "dragonmantank/cron-expression": "^3.6",
        "smalot/pdfparser": "^2.12",
        "phpoffice/phpword": "^1.4",
        "stripe/stripe-php": "^13.0",
        "square/square": "^35.0",
        "clicksend/clicksend-php": "^5.0"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "optimize-autoloader": true
    }
}
